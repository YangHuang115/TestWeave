{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "stableKey": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coreAction": {
            "type": "string",
            "minLength": 1
          },
          "coreExpected": {
            "type": "string",
            "minLength": 1
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "partitions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "name",
                "partitions"
              ],
              "additionalProperties": false
            }
          },
          "testMethod": {
            "type": "string",
            "minLength": 1
          },
          "testMethodReason": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "ruleRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "questionRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "moduleRelationRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowCaseGeneration": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "stableKey",
          "title",
          "description",
          "module",
          "scope",
          "preconditions",
          "coreAction",
          "coreExpected",
          "variables",
          "testMethod",
          "testMethodReason",
          "risk",
          "priority",
          "ruleRefs",
          "questionRefs",
          "moduleRelationRefs",
          "allowCaseGeneration"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "points"
  ],
  "additionalProperties": false
}
