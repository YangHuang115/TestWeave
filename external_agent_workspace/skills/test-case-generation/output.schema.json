{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "stableKey": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "primaryTestPointRef": {
            "type": "string",
            "minLength": 1
          },
          "ruleRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "testData": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string"
                },
                "purpose": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "value",
                "purpose"
              ],
              "additionalProperties": false
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "stepNo": {
                  "type": "integer",
                  "minimum": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "expected": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "stepNo",
                "action",
                "expected"
              ],
              "additionalProperties": false
            }
          },
          "coreExpected": {
            "type": "string",
            "minLength": 1
          },
          "observationPoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cleanupActions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "testMethod": {
            "type": "string",
            "minLength": 1
          },
          "assumptionRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "qualityPrecheck": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "PASS",
                  "WARNING",
                  "FAIL"
                ]
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "status",
              "findings"
            ],
            "additionalProperties": false
          },
          "id": {
            "type": "string"
          },
          "precondition": {
            "type": "string"
          },
          "expected_result": {
            "type": "string"
          }
        },
        "required": [
          "stableKey",
          "title",
          "module",
          "scope",
          "priority",
          "primaryTestPointRef",
          "ruleRefs",
          "preconditions",
          "testData",
          "steps",
          "coreExpected",
          "observationPoints",
          "cleanupActions",
          "testMethod",
          "assumptionRefs",
          "qualityPrecheck"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "cases"
  ],
  "additionalProperties": false
}
